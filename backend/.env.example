# Copy to backend/.env and fill in values. Do not commit the real .env.

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackfinance
# On Vercel: Supabase Transaction pooler URL (port 6543) + ?sslmode=require.
# For migrations/imports: Supabase Session pooler URL (port 5432) + ?sslmode=require.
# URL-encode special characters in the database password.
DATABASE_MIGRATION_URL=
# Only for the one-time DigitalOcean dump; remove after migration.
SOURCE_DATABASE_URL=
DEBUG=false

# ─── Auth / sessions ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ─── Scheduled jobs ──────────────────────────────────────────────
# Generate separately from SECRET_KEY. Store the same value in Supabase Vault.
CRON_SECRET=
# Vercel disables the in-process scheduler automatically; also set explicitly.
DISABLE_SCHEDULER=0
# Vercel always persists Telegram conversations. Use database locally to match.
TELEGRAM_STATE_BACKEND=memory

# ─── Public URLs (used in OAuth redirects, Telegram webhook URL) ──
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ─── AI assistant (Groq, used by in-app and Telegram bot) ─────────
GROQ_API_KEY=

# ─── Telegram bot ─────────────────────────────────────────────────
# Get a token from @BotFather: https://t.me/BotFather  →  /newbot
TELEGRAM_BOT_TOKEN=
# Your bot's @ handle, without the leading @ (e.g. TrackFinanceBot)
TELEGRAM_BOT_USERNAME=
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# ─── OAuth providers (optional) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── Email (optional, used for verification) ──────────────────────
RESEND_API_KEY=
FROM_EMAIL=TrackFinance <noreply@your-verified-domain.example>

# ─── Supabase avatar storage (backend only) ───────────────────────
# Generate S3 access credentials in Storage settings; these are NOT API keys.
AVATAR_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional: copy the S3 endpoint from Storage settings, otherwise derived above.
# SUPABASE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET=avatars
SUPABASE_STORAGE_REGION=eu-central-1
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# ─── Legacy Spaces (only while migrating existing avatars) ───────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
# Optional custom endpoint; omit to use the region's default.
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com

# ─── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development

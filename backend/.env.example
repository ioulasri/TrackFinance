# Copy to backend/.env and fill in values. Do not commit the real .env.

# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trackfinance

# ─── Auth / sessions ──────────────────────────────────────────────
SECRET_KEY=change-me-in-production

# ─── Public URLs (used in OAuth redirects, Telegram webhook URL) ──
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ─── AI assistant (Groq, used by in-app and Telegram bot) ─────────
GROQ_API_KEY=

# ─── Telegram bot ─────────────────────────────────────────────────
# Get a token from @BotFather: https://t.me/BotFather  →  /newbot
TELEGRAM_BOT_TOKEN=
# Your bot's @ handle, without the leading @ (e.g. TrackFinanceBot)
TELEGRAM_BOT_USERNAME=
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# ─── OAuth providers (optional) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ─── Email (optional, used for verification) ──────────────────────
RESEND_API_KEY=

# ─── CORS ─────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ENVIRONMENT=development
